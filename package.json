{
  "name": "localia-desktop",
  "version": "0.6.0",
  "description": "Assistant IA local pour macOS",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package": "electron-builder --mac dir --x64",
    "package:diffusion": "node scripts/package-diffusion.cjs",
    "captures": "node scripts/captures-readme.cjs",
    "logo": "node scripts/logo.cjs",
    "test:desktop": "node test/desktop.cjs",
    "test:pdf": "node test/pdf-desktop.cjs",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "vendor": "cp node_modules/markdown-it/dist/browser/markdown-it.umd.min.js src/vendor/markdown-it.min.js && cp node_modules/markdown-it/LICENSE src/vendor/markdown-it.LICENSE",
    "test:features": "node test/features-desktop.cjs",
    "test:encryption": "node test/encryption-desktop.cjs",
    "package:mac-arm64": "electron-builder --mac dir --arm64",
    "package:win": "electron-builder --win dir --x64",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "electron-builder --win nsis zip --x64",
    "package:linux": "electron-builder --linux dir --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "test:engine": "node test/engine-desktop.cjs",
    "test:foundry": "node test/foundry-desktop.cjs",
    "test:foundry-real": "node test/foundry-real.cjs",
    "build:apple-fm": "node scripts/apple-fm.cjs",
    "test:apple-real": "node test/apple-real.cjs"
  },
  "build": {
    "appId": "fr.localia.desktop",
    "productName": "Localia",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/node-llama-cpp/llama/localBuilds/**",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**",
      "!node_modules/@node-llama-cpp/*-cuda/**",
      "!node_modules/@node-llama-cpp/*-cuda-ext/**",
      "!node_modules/@tesseract.js-data/*/4.0.0/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        {
          "target": "dir"
        }
      ],
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native/apple-fm/bin",
          "to": "apple-fm"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Localia utilise le micro pour la dictée vocale : votre voix est transcrite sur cet ordinateur, sans Internet."
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Localia-${version}-Windows-installation.${ext}"
    },
    "artifactName": "Localia-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "localia",
      "maintainer": "Mohamed DIALLO <25933263+diallo68@users.noreply.github.com>",
      "synopsis": "Assistant de recherche local et banc d’essai de modèles (Ollama)"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/@napi-rs/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/smart-whisper/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "diallo68",
        "repo": "Localia",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "markdown-it": "15.0.2",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "electron-updater": "6.8.10",
    "node-llama-cpp": "^3.22.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "smart-whisper": "0.8.1",
    "tesseract.js": "7.0.0",
    "undici": "7.29.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diallo68/Localia.git"
  },
  "homepage": "https://github.com/diallo68/Localia"
}
